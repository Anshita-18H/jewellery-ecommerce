# Database
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=your-db-port

# Server
PORT=5000
SESSION_SECRET=your-session-secret

# Frontend URL
FRONTEND_URL=https://anshita-18h.github.io/jewellery-ecommerce/

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=AURA Fine Jewellery <your-email@domain.com>
EMAIL_FROM_NAME=AURA Fine Jewellery

# Razorpay TEST MODE Credentials (Obtain from https://dashboard.razorpay.com/#/app/keys in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
